@startuml 02-cube-core
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
component "alg text\nsiGN dialect" as text
component "bt_alg_parse\nrejects unknown tokens\ncarries the bad token back" as parse
component "bt_expand\nrepeats, commutators\ngroups, depth capped" as expand
component "bt_move stream\nface, wide, inner\nslice, rotation turns" as moves
component "bt_cube apply\nocc 54 sticker map\ninverse is the transpose" as cube
component "bt_summarize\ncycles, edge flips\ncorner twists" as summary
component "lengths and checks\nqtm, htm\ncenters fixed" as checks
text -> parse
parse -> expand
expand -> moves
moves -> cube
cube -> summary
summary -> checks
note bottom of cube
  solved means occ i equals i,
  the letter to sticker map
  is equality tested against
  ref_ground/position_map.tsv
end note
note bottom of checks
  only face turns keep centers
  fixed, every vendor alg is
  checked center fixed after
  full cancellation
end note
@enduml
