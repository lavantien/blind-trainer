@startuml 03-scheme
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
component "speffz map\none letter per sticker\nA to X per orbit" as map
component "pair space\nedge and corner pairs\nfloating buffer orders" as pairs
component "seeded scramble\ndeterministic from the seed" as scramble
component "classifier\ntrace blocks, defects\nclasses 3style flip twist\nparity ltct" as classifier
component "memo generation\nper orbit tokens" as memo
component "synthesis (gendata)\ncommutators for uncovered\npairs, fingertrick scored" as synth
component "data/vendor/cases.json\nalgs per pair and defect" as cases
component "drill cards\nside A and side B" as drill
map -> pairs
scramble -> classifier
pairs -> classifier
classifier -> memo
pairs -> synth
synth -> cases
cases -> drill
note bottom of memo
  edges stream syllables from
  data/ga/syllables.json, corners
  stream image words, bare
  letters when uncovered
end note
note bottom of classifier
  defects come from the
  emulated state itself,
  flips twists and parity
  feed the residue lines
end note
@enduml
