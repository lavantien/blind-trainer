@startuml 10-verification-chain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
rectangle "1 test\nworkspace suite" as s1
rectangle "2 fmt\nrustfmt check" as s2
rectangle "3 lint\nclippy -D warnings\nunder jobwrap" as s3
rectangle "4 policy\nzero comments, constants hub\nsloc max 1000 lines" as s4
rectangle "5 check\ncargo check workspace" as s5
rectangle "6 build\nrelease exe artifact" as s6
rectangle "7 fuzz\nnotation classify memo\ncommutator expand db fsrs" as s7
rectangle "8 mutation\nmutated packages\nscratch-local builds" as s8
rectangle "9 mutants-gate\nmerge outcomes\nsurvivors adjudicated\nin the allowlist" as s9
rectangle "10 e2e\nheadless suite plus\nsandboxed smoke and\nmissing config exit 1" as s10
rectangle "11 visual\ncommitted baselines\nverdict taxonomy\ncapture recipe log" as s11
rectangle "12 verify-algs\nper event tier report\ncounts and hashes\ngate fail closed" as s12
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s5
s5 -> s6
s6 -> s7
s7 -> s8
s8 -> s9
s9 -> s10
s10 -> s11
s11 -> s12
note bottom of s9
  a survivor leaves only with a\ndomain equivalence argument\nor a proven hang, rows are\nreviewed on every gate run
end note
note bottom of s12
  release adds dist then\nrelease-verify: zip byte\ncompare, packaged smoke,\nmissing config exit 1,\nusage exit 2
end note
@enduml
