@startuml 09-solve-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
rectangle "scramble applied\ncube state seeded" as scramble
rectangle "memo clock\nmemorization phase timer" as memo
rectangle "exec clock\nexecution phase timer" as exec
rectangle "space stops the clocks\nmemo, exec and total splits\nheld for the log" as stop
rectangle "corpus replay verify\nalg sequence applied to\nthe scrambled cube" as replay
rectangle "cube solved?" as solved
rectangle "solve log\nsuccess, times, piece split\nstats aggregation" as success
rectangle "solve log dnf\nwith divergence context" as dnf
scramble -> memo
memo -> exec
exec -> stop
stop -> replay
replay -> solved
solved -> success : yes
solved -> dnf : no
note bottom of success
  3d replay renders the solve
  on 27 cubies with animated
  turns, drag orbits and wheel
  zoom clamped.
end note
@enduml
