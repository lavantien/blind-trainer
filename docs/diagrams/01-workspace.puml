@startuml 01-workspace
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam componentStyle rectangle
skinparam packageStyle frame
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
package "src areas" {
  component "common\ntrace, harness, json\npaths, rng, sha256, strbuf" as common
  component "core\nalg parse, cube state\nmoves, expand, analysis" as core
  component "scheme\nspeffz map, classifier\nmemo tokens, scrambles" as scheme
  component "data\ncorpus, seedpack, sqlite\nrepos, fsrs, notation" as data
  component "puzzles\nnxn sq1 pyra skewb mega fto\ngeometry engines, tier 1" as puzzles
  component "ga\nsyllable evolution" as ga
  component "app\nwindow, drivers, views\nusage and smoke tours" as app
}
package "tools" {
  component "gendata\nvendor build, synthesis" as gendata
  component "verify\ncorpus and packs reports" as verify
  component "ga-run\nga batch driver" as garun
  component "memofreq\nletter frequency table" as memofreq
  component "mutate\nmutation engine" as mutate
  component "mutants-gate\nallowlist adjudication" as gate
  component "policy\ncomments, constants, sloc" as policy
  component "visual-diff\npng diff, selftest" as visual
  component "release-verify\nzip byte compare\npackaged exe stages" as relver
  component "jobwrap\njob object memory ceiling" as jobwrap
  component "sleeper\nmemguard fixture" as sleeper
}
component "tests\nunit, fuzz, e2e, visual\npython suite over bt.py" as tests
component "bt.py\nbuild, test, and gate driver" as driver
component "vendor\nraylib 6.2, sqlite 3.54.1\nsha pinned by scripts/vendor.py" as vendor
scheme -> core
data -> core
data -> scheme
puzzles -> core
ga -> core
ga -> scheme
ga -> data
app -> core
app -> scheme
app -> data
app -> puzzles
app -> ga
gendata -> data
gendata -> scheme
gendata -> puzzles
verify -> data
verify -> puzzles
garun -> ga
memofreq -> ga
memofreq -> scheme
memofreq -> data
app -> vendor
data -> vendor
driver ..> app : compiles and links
driver ..> tests : builds and runs
driver ..> verify : gate
mutate ..> tests : replays unit suites
gate ..> driver : outcomes verdict
policy ..> core : scans sources
visual ..> tests : diffs baselines
note bottom of common
  common underlies every
  src area and tool
end note
note bottom of app
  the usage and smoke tours
  drive real view flows
  headless for the gallery
  and the visual baselines
end note
@enduml
