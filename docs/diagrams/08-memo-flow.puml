@startuml 08-memo-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam ActivityBackgroundColor #2f3439
skinparam ActivityFontColor #FFFFFF
skinparam NoteBackgroundColor #f4f5f6
start
:seeded scramble\ndeterministic from seed\nsmoke pins the stream;
:decompose to pairs\nedges then corners\nbuffer relative order;
:memo tokens\nedges as syllables\ncorners as image words;
:per orbit stream\ncadence from config\nclamped bounds;
:intro, stream, recall, review\nphases driven by keyboard;
:recall\ntokens hidden, space reveals\nthe full memo with residue;
:rate\nkeys 1 to 4 grade each\nstreamed pair into FSRS;
note right
  memo mode parses from config,
  the stream is reproducible
  which keeps the memo smoke
  shot byte stable.
end note
stop
@enduml
