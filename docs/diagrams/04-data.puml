@startuml 04-data
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam NoteBackgroundColor #f4f5f6
component "ref_ground corpus\nsolver sheets, sha256 pinned" as corpus
component "corpus loader\nrows with solver, sheet\ncontent hashes" as loader
component "data/vendor\nmanifest, cases, specials" as vendor
component "ref_ground packs\ntsv plus registry.json" as packs
component "seedpack loader\nparse, normalize\nrulings on expected failures" as seedpack
component "sqlite user db\nnumbered migrations\nbackup before each step" as db
component "repos\nalgs, seeds, cards, srs\nsolves, settings, user" as repos
component "fsrs scheduler\n19 weights, request retention\ninterval clamp" as fsrs
corpus -> loader
loader -> vendor
packs -> seedpack
seedpack -> db
vendor -> db
db -> repos
repos -> fsrs
note bottom of db
  blind-trainer.db lives in the
  user dir, legacy json imports
  once and renames to .migrated
end note
note bottom of fsrs
  ratings 1 to 4 map to again,
  hard, good, easy, the math is
  pinned by reference vectors
  under ref_ground/fsrs
end note
@enduml
