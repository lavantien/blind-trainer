@startuml 04-data
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #2f3439
skinparam rectangleBackgroundColor #2f3439
skinparam rectangleFontColor #FFFFFF
skinparam databaseBackgroundColor #8a9099
skinparam NoteBackgroundColor #f4f5f6
rectangle "ref_ground corpus tsv\ncherry eggins workbooks\nunder the gpl carve-out" as tsv
rectangle "ref_ground packs tsv\nregistry pinned\nprovenance tagged" as packs
rectangle "seedpack loader\nnormalize commas parens\n(g)2 repeats, -> chains\ncanonical content hash" as loader
rectangle "SQLite db\nuser_version migrations\nbackup before migrate\nlegacy json to .migrated" as db
database "seed_alg\nuser_alg\ncard\nfsrs_state\nreview_log" as tables
rectangle "effective alg\nuser row overrides seed\ndelete reverts to seed" as overlay
rectangle "bt-verify tiers\ntier 1 mechanical\ntier 2 structural stage\nfail closed on drift" as verify
rectangle "FSRS-5 scheduler\npinned weights\nstability difficulty\ninterval clamp from config" as fsrs
tsv -> loader
packs -> loader
loader -> db
db -> tables
tables -> overlay
overlay --> verify
overlay --> fsrs
fsrs --> tables : review_log append
note bottom of verify
  repo gates fail on any tier 1\nfailure, row count drift or\nhash drift, the app degrades\nwith boot warnings instead
end note
note right of tables
  3bld pairs map onto the same\ncard table as every event\nso one scheduler drives\nall drilling
end note
@enduml
